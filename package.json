{
  "name": "node-game",
  "version": "0.1.0",
  "description": "NODE \u2014 a turn-based rural development strategy game (see SPEC.md)",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node serve.js",
    "test": "node scripts/test-engine.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:fullrun",
    "sync": "cap sync android",
    "build:apk": "cd android && gradlew assembleDebug",
    "test:fullrun": "node scripts/test-fullrun.js"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0"
  }
}
